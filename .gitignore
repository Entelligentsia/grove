/target
grove.lock
dist/npm/vendor/
dist/npm/node_modules/

# Forge — transient agent event logs (one file per phase, do not commit)
.forge/store/events/

# Runtime artifact from `grove serve` / tap debugging
server.pid

# mdBook output (generated into the Pages site by pages.yml)
/site/docs/

# Forge session transcripts — ephemeral logs that can capture env/secret output; never publish.
.forge/transcripts/

# Forge run/debug logs — also capture command output verbatim (same leak risk).
.forge/cache/run-task-debug-*.jsonl
.forge/cache/FRICTION-*.jsonl
.forge/cache/run-sprint-state-*.json
.forge/cache/run-task-state-*.json
